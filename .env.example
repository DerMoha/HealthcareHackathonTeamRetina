# Copy to .env (never commit .env). Read by the backend only.

# Needed for PRIVATE ElevenLabs agents (backend mints short-lived conversation
# tokens at GET /elevenlabs/conversation-token) and, for any agent, for the
# notebook's consultation summary (GET /elevenlabs/conversations/{id}/summary).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Backend bind address. 0.0.0.0 so the Vision Pro can reach it over LAN.
MEDSIM_HOST=0.0.0.0
MEDSIM_PORT=8000
# Optional: override scenario directory (default: ../scenarios relative to backend/)
# MEDSIM_SCENARIOS_DIR=

# Optional: AI drafting in MedSim Studio (POST /studio/assist). Without it, drafts are
# built from the template. Also needs: pip install anthropic
# ANTHROPIC_API_KEY=
# Optional: where the scenario library is stored (default backend/data/studio_library.json)
# MEDSIM_STUDIO_DB=
